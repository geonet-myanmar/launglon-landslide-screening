	<Folder id="015F6F6146423A11FC78">
		<name>2026 Taw Kye — screening envelopes</name>
		<Placemark id="10A726C424423A11FC78">
			<name>LS-01 — Northern debris-flood fan</name>
			<description><![CDATA[<b>Class:</b> 2026 confirmed / historical relation pending<br/>
    <b>2026 feature:</b> Northern debris-flood fan<br/>
    <b>Interpretation:</b> Debris-flood / mudflow deposit; feeder enters from outside survey.<br/><br/>
    <b>Important:</b> This polygon is a conservative screening envelope derived from the published
    interpreter envelope extent. It is NOT the exact scar outline. Historical-image screenshots
    (2005, 2011, 2016, 2019, 2021, 2023) indicate pre-existing disturbed terrain, hollows and channels,
    but screenshot perspective alone is insufficient to assign an exact old-scar polygon.]]></description>
			<styleUrl>#confirmed</styleUrl>
			<ExtendedData>
				<Data name="class">
					<value>2026 confirmed / historical relation pending</value>
				</Data>
				<Data name="confidence">
					<value>screening</value>
				</Data>
				<Data name="source_crs">
					<value>EPSG:32647</value>
				</Data>
			</ExtendedData>
			<Polygon>
				<outerBoundaryIs>
					<LinearRing>
						<coordinates>
							98.1559534,13.8011955,0 98.16016269999999,13.8012099,0 98.1601543,13.8035606,0 98.155945,13.8035462,0 98.1559534,13.8011955,0 
						</coordinates>
					</LinearRing>
				</outerBoundaryIs>
			</Polygon>
		</Placemark>
		<Placemark id="255E80D9CF423A11FC78">
			<name>LS-02 — Narrow northern debris flow</name>
			<description><![CDATA[<b>Class:</b> Possible reactivation — verify<br/>
    <b>2026 feature:</b> Narrow northern debris flow<br/>
    <b>Interpretation:</b> Long narrow scar; channelised runout into LS-01.<br/><br/>
    <b>Important:</b> This polygon is a conservative screening envelope derived from the published
    interpreter envelope extent. It is NOT the exact scar outline. Historical-image screenshots
    (2005, 2011, 2016, 2019, 2021, 2023) indicate pre-existing disturbed terrain, hollows and channels,
    but screenshot perspective alone is insufficient to assign an exact old-scar polygon.]]></description>
